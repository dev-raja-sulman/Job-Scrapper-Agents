# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev; swap to postgresql://... in production)
DATABASE_URL=sqlite:///./jobs.db

# Groq API key — used for job summarization, scam-flagging, cover letters, and interview prep
GROQ_API_KEY=your-key-here

# How often the scraper agent runs, in minutes
SCRAPE_INTERVAL_MINUTES=60

# Comma-separated search keywords used against job source APIs
SEARCH_KEYWORDS=python,backend,ai engineer
